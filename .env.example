# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dameunapatadb

# NextAuth configuration
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Optional: protects debug endpoints in non-production environments
DEBUG_API_TOKEN=replace-with-debug-token

# Optional: used by `npm run db:seed` to create/update the first admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-temporary-password

# Public contact links
NEXT_PUBLIC_WHATSAPP_NUMBER=595991234567
